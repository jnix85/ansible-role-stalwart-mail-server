# {{ ansible_managed }}
# MX edge relay: accept for our domains, scan via rspamd, forward to
# the mailbox server. No local mailboxes on this host.

myhostname = {{ inventory_hostname }}
smtpd_banner = $myhostname ESMTP
biff = no
compatibility_level = 3.6

# Relay-only: nothing is delivered locally.
mydestination =
local_recipient_maps =
local_transport = error:local delivery disabled
mynetworks = 127.0.0.0/8 [::1]/128

relay_domains = {{ mail_domains | join(', ') }}
transport_maps = hash:/etc/postfix/transport
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination

# TLS for inbound connections.
{% if mx_le_cert_final.stat.exists %}
smtpd_tls_cert_file = /etc/letsencrypt/live/{{ inventory_hostname }}/fullchain.pem
smtpd_tls_key_file = /etc/letsencrypt/live/{{ inventory_hostname }}/privkey.pem
{% else %}
smtpd_tls_cert_file = /etc/ssl/certs/ssl-cert-snakeoil.pem
smtpd_tls_key_file = /etc/ssl/private/ssl-cert-snakeoil.key
{% endif %}
smtpd_tls_security_level = may
smtp_tls_security_level = may

# rspamd as milter.
smtpd_milters = inet:127.0.0.1:11332
non_smtpd_milters = inet:127.0.0.1:11332
milter_default_action = accept
milter_protocol = 6

message_size_limit = {{ mx_message_size_limit }}
smtpd_helo_required = yes
disable_vrfy_command = yes
