---
# Generated by Terraform — do not edit by hand (terraform apply rewrites it).
all:
  vars:
    ansible_user: ${admin_username}
  children:
    mx_edges:
      hosts:
%{ for name, host in mx_hosts ~}
        ${name}.${domain}:
          ansible_host: ${host.public_ip}
          private_ip: ${host.private_ip}
%{ endfor ~}
    mailservers:
      hosts:
%{ for name, host in mailbox_hosts ~}
        ${name}.${domain}:
          ansible_host: ${host.public_ip}
          private_ip: ${host.private_ip}
          data_disk_lun: ${host.data_disk_lun}
%{ endfor ~}
