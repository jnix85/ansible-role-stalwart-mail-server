{{ ansible_managed | comment }}
[Unit]
Description=Stalwart Mail Server
Documentation=https://stalw.art/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ stalwart_user }}
Group={{ stalwart_group }}
ExecStart={{ stalwart_install_dir }}/bin/stalwart --config={{ stalwart_install_dir }}/etc/config.toml
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ stalwart_service_name }}

# Allow binding privileged ports (25, 143, 443, ...) as a non-root user.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ ([stalwart_install_dir, stalwart_data_dir, stalwart_log_dir]
  + ([stalwart_selfsigned_dir] if stalwart_tls_mode == 'selfsigned' else []))
  | unique | join(' ') }}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
