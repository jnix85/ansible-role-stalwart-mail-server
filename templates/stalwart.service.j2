{{ ansible_managed | comment }}
[Unit]
Description=Stalwart Mail Server
Documentation=https://stalw.art/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ stalwart_user }}
Group={{ stalwart_group }}
# Bootstrap settings that are not part of the data store descriptor.
# Kept in a 0640 file rather than Environment= lines because the unit
# itself is world readable and this carries the admin password.
EnvironmentFile={{ stalwart_env_file }}
ExecStart={{ stalwart_install_dir }}/bin/stalwart --config {{ stalwart_config_file }}
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ stalwart_service_name }}

# Allow binding privileged ports (25, 443, 465, ...) as a non-root user.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ [stalwart_install_dir, stalwart_data_dir] | unique | join(' ') }}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
