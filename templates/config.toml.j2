{{ ansible_managed | comment }}
#
# Local Stalwart configuration. Most runtime settings are managed
# through the web admin UI and stored in the database; this file holds
# the local bootstrap settings (listeners, storage, TLS, logging).

[server]
hostname = "{{ stalwart_hostname }}"

{% if stalwart_smtp_enabled %}
[server.listener."smtp"]
bind = ["{{ stalwart_effective_listen_address }}:{{ stalwart_smtp_port }}"]
protocol = "smtp"

{% endif %}
{% if stalwart_submission_enabled %}
[server.listener."submission"]
bind = ["{{ stalwart_effective_listen_address }}:{{ stalwart_submission_port }}"]
protocol = "smtp"

{% endif %}
{% if stalwart_submissions_enabled %}
[server.listener."submissions"]
bind = ["{{ stalwart_effective_listen_address }}:{{ stalwart_submissions_port }}"]
protocol = "smtp"
tls.implicit = true

{% endif %}
{% if stalwart_imap_enabled %}
[server.listener."imap"]
bind = ["{{ stalwart_effective_listen_address }}:{{ stalwart_imap_port }}"]
protocol = "imap"

{% endif %}
{% if stalwart_imaps_enabled %}
[server.listener."imaptls"]
bind = ["{{ stalwart_effective_listen_address }}:{{ stalwart_imaps_port }}"]
protocol = "imap"
tls.implicit = true

{% endif %}
{% if stalwart_pop3_enabled %}
[server.listener."pop3"]
bind = ["{{ stalwart_effective_listen_address }}:{{ stalwart_pop3_port }}"]
protocol = "pop3"

[server.listener."pop3s"]
bind = ["{{ stalwart_effective_listen_address }}:{{ stalwart_pop3s_port }}"]
protocol = "pop3"
tls.implicit = true

{% endif %}
{% if stalwart_managesieve_enabled %}
[server.listener."sieve"]
bind = ["{{ stalwart_effective_listen_address }}:{{ stalwart_managesieve_port }}"]
protocol = "managesieve"

{% endif %}
{% if stalwart_https_enabled %}
[server.listener."https"]
bind = ["{{ stalwart_effective_listen_address }}:{{ stalwart_https_port }}"]
protocol = "http"
tls.implicit = true

{% endif %}
{% if stalwart_http_enabled %}
[server.listener."http"]
bind = ["{{ stalwart_effective_listen_address }}:{{ stalwart_http_port }}"]
protocol = "http"

{% endif %}
[storage]
data = "{{ stalwart_storage_backend }}"
fts = "{{ stalwart_storage_backend }}"
blob = "{{ stalwart_storage_backend }}"
lookup = "{{ stalwart_storage_backend }}"
directory = "internal"

{% if stalwart_storage_backend == 'rocksdb' %}
[store."rocksdb"]
type = "rocksdb"
path = "{{ stalwart_data_dir }}"
compression = "{{ stalwart_rocksdb_compression }}"
{% elif stalwart_storage_backend == 'sqlite' %}
[store."sqlite"]
type = "sqlite"
path = "{{ stalwart_data_dir }}/index.sqlite3"
{% elif stalwart_storage_backend == 'postgresql' %}
[store."postgresql"]
type = "postgresql"
host = "{{ stalwart_postgresql_host }}"
port = {{ stalwart_postgresql_port }}
database = "{{ stalwart_postgresql_database }}"
user = "{{ stalwart_postgresql_user }}"
password = "{{ stalwart_postgresql_password }}"
timeout = "{{ stalwart_postgresql_timeout }}"
{% endif %}

[directory."internal"]
type = "internal"
store = "{{ stalwart_storage_backend }}"

[tracer."log"]
type = "log"
level = "{{ stalwart_log_level }}"
path = "{{ stalwart_log_dir }}"
prefix = "stalwart.log"
rotate = "{{ stalwart_log_rotate }}"
ansi = false
enable = true

[authentication.fallback-admin]
user = "{{ stalwart_admin_user }}"
secret = "{{ stalwart_admin_secret_hash }}"

{% if stalwart_tls_mode == 'acme' %}
[acme."default"]
directory = "{{ stalwart_acme_directory_url }}"
challenge = "{{ stalwart_acme_challenge }}"
contact = ["mailto:{{ stalwart_acme_contact }}"]
domains = [{% for domain in stalwart_acme_domains %}"{{ domain }}"{% if not loop.last %}, {% endif %}{% endfor %}]
cache = "{{ stalwart_install_dir }}/etc/acme"
default = true
{% else %}
[certificate."default"]
cert = "%{file:{{ stalwart_effective_cert_file }}}%"
private-key = "%{file:{{ stalwart_effective_key_file }}}%"
default = true
{% endif %}
{% if stalwart_extra_config | length > 0 %}

# --- Extra configuration (stalwart_extra_config) ---
{{ stalwart_extra_config }}
{% endif %}
