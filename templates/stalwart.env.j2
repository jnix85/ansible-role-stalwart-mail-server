{{ ansible_managed | comment }}
# Bootstrap environment for the Stalwart service. Everything else is
# configured inside the data store from the web admin.
STALWART_HOSTNAME={{ stalwart_hostname }}
STALWART_PUBLIC_URL={{ stalwart_public_url }}
STALWART_HTTPS_PORT={{ stalwart_https_port }}
# Creates a temporary "recovery-admin" account for first login.
STALWART_RECOVERY_ADMIN={{ stalwart_admin_password }}
