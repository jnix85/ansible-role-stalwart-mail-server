{{ ansible_managed | comment }}
# Bootstrap environment for the Stalwart service. Everything else is
# configured inside the data store from the web admin.
STALWART_HOSTNAME={{ stalwart_hostname }}
STALWART_PUBLIC_URL={{ stalwart_public_url }}
STALWART_HTTPS_PORT={{ stalwart_https_port }}
# Pins the administrator credential. The "<user>:<password>" form is
# required — a bare password is ignored and leaves no way to log in,
# because a server started with a config file never enters the
# bootstrap mode that would otherwise print generated credentials.
STALWART_RECOVERY_ADMIN={{ stalwart_admin_user }}:{{ stalwart_admin_password }}
